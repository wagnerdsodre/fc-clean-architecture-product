{
  "devDependencies": {
    "@swc/cli": "^0.1.55",
    "@swc/core": "^1.2.148",
    "@swc/jest": "^0.2.20",
    "@types/jest": "^27.4.1",
    "@types/jstoxml": "^2.0.2",
    "@types/supertest": "^2.0.12",
    "jest": "^27.5.1",
    "supertest": "^6.2.2",
    "ts-node": "^10.6.0",
    "tslint": "^6.1.3",
    "typescript": "^4.5.5"
  },
  "scripts": {
    "test": "npm run tsc -- --noEmit && jest",
    "test:product": "npm run tsc -- --noEmit && jest --config jest.product.config.ts --runInBand",
    "test:product:unit": "npm run test:product -- --testPathPattern=unit.spec.ts$",
    "test:product:integration": "npm run test:product -- --testPathPattern=integration.spec.ts$",
    "test:coverage": "npm run test:product -- --coverage",
    "test:e2e": "npm run tsc -- --noEmit && jest --runInBand --testPathPattern=e2e.spec.ts$",
    "tsc": "tsc",
    "dev": "nodemon --exec \"node -r ts-node/register\" src/infrastructure/api/server.ts"
  },
  "dependencies": {
    "@types/express": "^4.17.13",
    "@types/uuid": "^8.3.4",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "jstoxml": "^3.2.3",
    "nodemon": "^2.0.15",
    "reflect-metadata": "^0.1.13",
    "sequelize": "^6.17.0",
    "sequelize-typescript": "^2.1.3",
    "sqlite3": "^5.0.2",
    "uuid": "^8.3.2",
    "yup": "^0.32.11"
  }
}
